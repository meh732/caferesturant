{
  "name": "react-example",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "predev": "node setup-pwa-assets.cjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "node server.js",
    "local": "vite --port=7375 --host=0.0.0.0",
    "build": "node setup-pwa-assets.cjs && node fix-ico.cjs && node --max-old-space-size=1024 ./node_modules/vite/bin/vite.js build && node -e \"const fs = require('fs'); fs.mkdirSync('dist', { recursive: true }); fs.copyFileSync('src/assets/images/arka_logo.png', 'dist/arka_logo.png'); fs.copyFileSync('src/assets/images/arka_logo.ico', 'dist/arka_logo.ico');\"",
    "build:server": "node -e \"process.env.VITE_APP_EDITION='server'; require('child_process').execSync('npm run build', { stdio: 'inherit', env: process.env })\"",
    "build:client": "node -e \"process.env.VITE_APP_EDITION='client'; require('child_process').execSync('npm run build', { stdio: 'inherit', env: process.env })\"",
    "tauri": "npx @tauri-apps/cli",
    "tauri:icon": "npx @tauri-apps/cli icon src/assets/images/arka_logo.png",
    "tauri:dev": "npx @tauri-apps/cli dev",
    "version:bump": "node bump-version.cjs",
    "pretauri:build": "npm run build",
    "tauri:build": "npx @tauri-apps/cli build",
    "prebuild:win": "npm run build",
    "build:win": "npx @tauri-apps/cli build",
    "build:win:server": "node scripts/prepare-win-postgres.mjs && npx @tauri-apps/cli build --config src-tauri/tauri.server.conf.json --features server-edition",
    "build:win:client": "npx @tauri-apps/cli build --config src-tauri/tauri.client.conf.json -- --no-default-features --features client-edition",
    "build:win:all": "npm run build:win:server && npm run build:win:client",
    "electron:dev": "electron main.cjs",
    "build:electron:server": "node scripts/build-electron.mjs server",
    "build:electron:client": "node scripts/build-electron.mjs client",
    "build:electron:all": "node scripts/build-electron.mjs all",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "preview-local": "vite preview --port=7375 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-multi-date-picker": "^4.5.2",
    "react-to-print": "^3.3.0",
    "vazirmatn": "^33.0.3",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^2.0.0"
  }
}
